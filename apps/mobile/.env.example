# Copy to .env (gitignored). Expo inlines EXPO_PUBLIC_* vars at build time.

# Penny API. Leave unset in development to use the dev machine's LAN IP on port 4000.
# Google sign-in in development: Google only accepts localhost (or HTTPS) redirect URIs, so run
#   adb reverse tcp:4000 tcp:4000
# and set this to http://localhost:4000 (the same host as BETTER_AUTH_URL in apps/api/.env).
EXPO_PUBLIC_API_URL=

# Better Auth Infrastructure (Sentinel) ingestion URL, from your project's settings page in the
# Better Auth dashboard, e.g. https://kv.better-auth.com/api/v1/projects/<id>
EXPO_PUBLIC_BETTER_AUTH_KV_URL=
