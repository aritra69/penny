# Penny's one env file. Copy to .env at the repo root (gitignored); every app reads from it:
#   api     bun --env-file=../../.env (see apps/api/package.json)
#   web     next.config.js loads it with @next/env
#   mobile  metro.config.js loads it before Expo inlines EXPO_PUBLIC_* vars
# After changing an EXPO_PUBLIC_* value, restart Expo with `bunx expo start -c`.

# ── API (apps/api) ─────────────────────────────────────────────────────────────

# Signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API. Google redirects back to $BETTER_AUTH_URL/api/auth/callback/google.
BETTER_AUTH_URL=http://localhost:4000

# Google sign-in (Google Cloud console → Credentials → OAuth client ID → "Web application").
# Add http://localhost:4000/api/auth/callback/google as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth Infrastructure (dashboard + Sentinel abuse protection). Optional.
BETTER_AUTH_API_KEY=

# ── Web (apps/web) ─────────────────────────────────────────────────────────────

# Where the Penny API runs. The waitlist form posts to $PENNY_API_URL/waitlist from the server.
PENNY_API_URL=http://localhost:4000

# Founding-member pre-order. Paste a Stripe Payment Link (https://buy.stripe.com/...) to turn the
# section on; leave empty to hide it. Optional: the date after which refunds become automatic.
FOUNDING_CHECKOUT_URL=
FOUNDING_REFUND_BY=

# ── Mobile (apps/mobile) ───────────────────────────────────────────────────────

# Penny API. Leave unset in development to use the dev machine's LAN IP on port 4000.
# Google sign-in in development: Google only accepts localhost (or HTTPS) redirect URIs, so run
#   adb reverse tcp:4000 tcp:4000
# and set this to http://localhost:4000 (the same host as BETTER_AUTH_URL above).
EXPO_PUBLIC_API_URL=

# Better Auth Infrastructure (Sentinel) ingestion URL, from your project's settings page in the
# Better Auth dashboard, e.g. https://kv.better-auth.com/api/v1/projects/<id>
EXPO_PUBLIC_BETTER_AUTH_KV_URL=

# Onboarding's key check picks the newest small GPT model the user's key can use. Set this to
# check for (and report) one model by name instead.
EXPO_PUBLIC_OPENAI_MODEL=
