# Penny's one env file. Copy to .env at the repo root (gitignored); every app reads from it:
#   api     bun --env-file=../../.env (see apps/api/package.json)
#   web     next.config.js loads it with @next/env
#   mobile  babel.config.js loads it and inlines RN_PUBLIC_* vars into the bundle
# After changing an RN_PUBLIC_* value, restart Metro with `bun run start --reset-cache` (apps/mobile).

# ── API (apps/api) ─────────────────────────────────────────────────────────────

# Postgres. `bun run db:up` starts one in Docker with exactly these credentials (docker-compose.yml).
DATABASE_URL=postgres://penny:penny@localhost:5432/penny

# Encrypts amounts, merchants, categories and notes before they are stored. 32 random bytes:
#   openssl rand -base64 32
# Keep it out of the database and its backups. If it is lost, the stored data can't be read.
DATA_ENCRYPTION_KEY=

# Signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API. Google redirects back to $BETTER_AUTH_URL/api/auth/callback/google.
BETTER_AUTH_URL=http://localhost:4000

# Google sign-in (Google Cloud console → Credentials → OAuth client ID → "Web application").
# Add http://localhost:4000/api/auth/callback/google as an authorised redirect URI.
# The mobile app signs in natively and sends Google's ID token, which is issued for this client ID.
# It also needs an "Android" OAuth client for package com.penny.mobile with your signing
# certificate's SHA-1 (`cd apps/mobile/android && ./gradlew signingReport`).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth Infrastructure (dashboard + Sentinel abuse protection). Optional.
BETTER_AUTH_API_KEY=

# ── Web (apps/web) ─────────────────────────────────────────────────────────────

# Where the Penny API runs. The waitlist form posts to $PENNY_API_URL/waitlist from the server.
PENNY_API_URL=http://localhost:4000

# Founding-member pre-order. Paste a Stripe Payment Link (https://buy.stripe.com/...) to turn the
# section on; leave empty to hide it. Optional: the date after which refunds become automatic.
FOUNDING_CHECKOUT_URL=
FOUNDING_REFUND_BY=

# ── Mobile (apps/mobile) ───────────────────────────────────────────────────────

# Penny API. Leave unset in development to use the machine running Metro, on port 4000 (its LAN IP,
# or 10.0.2.2 on an emulator). With a USB device and `bun run adb:reverse`, set http://localhost:4000.
RN_PUBLIC_API_URL=

# Better Auth Infrastructure (Sentinel) ingestion URL, from your project's settings page in the
# Better Auth dashboard, e.g. https://kv.better-auth.com/api/v1/projects/<id>
RN_PUBLIC_BETTER_AUTH_KV_URL=

# Onboarding's key check picks the newest small GPT model the user's key can use. Set this to
# check for (and report) one model by name instead.
RN_PUBLIC_OPENAI_MODEL=

# Google web client ID for native Google sign-in. Defaults to GOOGLE_CLIENT_ID above.
RN_PUBLIC_GOOGLE_WEB_CLIENT_ID=
